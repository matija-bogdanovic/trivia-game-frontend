# Copy to .env for local development, and set the same keys in the Vercel
# dashboard for the deployed app. Everything here is NEXT_PUBLIC_*, which means
# it is inlined into the client bundle at build time — do not put secrets here.

# --- Backend: REST (serverless) --------------------------------------------
# Lambda behind API Gateway. Everything apiFetch calls — wallet, createRoom,
# joinRoom, lobbies, and the avatar upload/read.
# Local dev:  https://in0nom6ecd.execute-api.eu-west-3.amazonaws.com/prod
# Production: the same, unless a separate stage is deployed
NEXT_PUBLIC_API_URL=https://in0nom6ecd.execute-api.eu-west-3.amazonaws.com/prod

# --- Backend: the game socket ----------------------------------------------
# The real-time game is still the always-on ws server; it did NOT move to
# serverless. Do not point this at the API Gateway above — a REST endpoint
# cannot serve a WebSocket and the socket would fail to connect.
# Leave unset to fall back to http://localhost:3001 in dev and the deployed
# game host otherwise.
# NEXT_PUBLIC_WS_URL=https://whoisfaster.onrender.com

# --- App origin ------------------------------------------------------------
# Used for the Cognito OAuth redirectSignIn / redirectSignOut URLs, so it MUST
# match the origin the app is actually served from, and the exact same value
# must be registered in the Cognito app client's callback + logout URLs.
# Local dev:  http://localhost:3000/
# Production: https://<your-domain>/
NEXT_PUBLIC_APP_URL=http://localhost:3000/

# --- Cognito ---------------------------------------------------------------
# Public identifiers (they already appear as fallbacks in
# src/app/lib/amplify_configure.ts), not credentials.
NEXT_PUBLIC_USER_POOL_ID=eu-west-3_Uylh5ZFUK
NEXT_PUBLIC_USER_POOL_CLIENT_ID=3j69q67dfk60kl92gukqhdlr91
NEXT_PUBLIC_IDENTITY_POOL_ID=eu-west-3:ee26e62a-ab48-4755-b656-462f3cca5ece
NEXT_PUBLIC_COGNITO_DOMAIN=eu-west-3uylh5zfuk.auth.eu-west-3.amazoncognito.com

# Set to 1 to show the "Continue with Google" button. Requires the Google
# identity provider on the pool AND this origin in the callback URLs.
NEXT_PUBLIC_GOOGLE_AUTH=1
